generator client {
  provider     = "prisma-client"
  output       = "../src/persistence/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model WorkbookRecord {
  id                      String                         @id
  name                    String
  currentRevision         Int                            @map("current_revision")
  worksheets              WorksheetRecord[]
  calculationObservations CalculationObservationRecord[]

  @@map("workbooks")
}

model CalculationObservationRecord {
  id             String                       @id @default(cuid())
  workbookId     String                       @map("workbook_id")
  sourceRevision Int                          @map("source_revision")
  observedAt     DateTime                     @default(now()) @map("observed_at")
  graphJson      String                       @map("graph_json")
  traceJson      String                       @map("trace_json")
  workbook       WorkbookRecord               @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  cellValues     CalculationCellValueRecord[]

  @@index([workbookId, sourceRevision, observedAt], map: "calculation_observations_by_revision")
  @@map("calculation_observations")
}

model CalculationCellValueRecord {
  observationId       String                       @map("observation_id")
  worksheetId         String                       @map("worksheet_id")
  rowNumber           Int                          @map("row_number")
  columnNumber        Int                          @map("column_number")
  kind                String
  numberValue         Float?                       @map("number_value")
  textValue           String?                      @map("text_value")
  booleanValue        Boolean?                     @map("boolean_value")
  errorCode           String?                      @map("error_code")
  errorOriginCellId   String?                      @map("error_origin_cell_id")
  errorMessage        String?                      @map("error_message")
  formulaAnalysisJson String?                      @map("formula_analysis_json")
  observation         CalculationObservationRecord @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@id([observationId, worksheetId, rowNumber, columnNumber])
  @@index([worksheetId, rowNumber, columnNumber], map: "calculation_values_by_cell")
  @@map("calculation_cell_values")
}

model WorksheetRecord {
  workbookId String         @map("workbook_id")
  id         String
  name       String
  position   Int
  workbook   WorkbookRecord @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  cells      CellRecord[]

  @@id([workbookId, id])
  @@unique([workbookId, position])
  @@unique([workbookId, name])
  @@map("worksheets")
}

model CellRecord {
  workbookId       String          @map("workbook_id")
  worksheetId      String          @map("worksheet_id")
  rowNumber        Int             @map("row_number")
  columnNumber     Int             @map("column_number")
  contentJson      String?         @map("content_json")
  modifiedRevision Int             @map("modified_revision")
  worksheet        WorksheetRecord @relation(fields: [workbookId, worksheetId], references: [workbookId, id], onDelete: Cascade)

  @@id([workbookId, worksheetId, rowNumber, columnNumber])
  @@index([workbookId, worksheetId, rowNumber, columnNumber], map: "cells_by_workbook")
  @@map("cells")
}
